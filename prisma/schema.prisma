generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model store {
  id             String         @id @default(cuid())
  name           String
  address        String?
  phone          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  cashMovements  CashMovement[]
  cashRegisters  CashRegister[]
  stockHistories StockHistory[]
  categories     categories[]
  clients        client[]
  orders         order[]
  payments       payment[]
  products       product[]
  suppliers      supplier[]
  users          user[]
}

model user {
  id                  String         @id @default(cuid())
  storeId             String?
  email               String         @unique
  password            String
  firstName           String
  lastName            String
  fullName            String?
  phoneNumber         String
  address             String
  city                String
  profilePicture      String?
  role                String         @default("USUARIO")
  isActive            Boolean        @default(true)
  mustChangePassword  Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  cashMovements       CashMovement[]
  closedCashRegisters CashRegister[] @relation("ClosedCashRegisters")
  openedCashRegisters CashRegister[] @relation("OpenedCashRegisters")
  Image               Image[]
  stockHistories      StockHistory[]
  orders              order[]
  payments            payment[]
  store               store?         @relation(fields: [storeId], references: [id])
}

model client {
  id             String    @id @default(cuid())
  storeId        String
  email          String
  firstName      String
  lastName       String
  fullName       String?
  dni            String
  cuit           String?
  phoneNumber    String
  address        String
  city           String
  profilePicture String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  isActive       Boolean   @default(true)
  Image          Image[]
  store          store     @relation(fields: [storeId], references: [id])
  orders         order[]
  payments       payment[]
}

model supplier {
  id             String   @id @default(cuid())
  storeId        String
  email          String?
  firstName      String?
  lastName       String?
  fullName       String?
  dni            String?
  cuit           String?
  phoneNumber    String?
  address        String?
  city           String?
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isActive       Boolean  @default(true)
  Image          Image[]
  store          store    @relation(fields: [storeId], references: [id])
}

model order {
  id             String         @id @default(cuid())
  storeId        String
  userId         String?
  cashRegisterId String?
  clientId       String?
  orderDate      DateTime       @default(now())
  amount         Float
  amoutPayed     Float          @default(0)
  amoutToPaid    Float          @default(0)
  paymentMethod  String?
  status         String         @default("pending")
  statusPayment  String?        @default("pending")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  orderPayments  OrderPayment[]
  cashRegister   CashRegister?  @relation(fields: [cashRegisterId], references: [id])
  client         client?        @relation(fields: [clientId], references: [id])
  store          store          @relation(fields: [storeId], references: [id])
  user           user?          @relation(fields: [userId], references: [id])
  orderDetails   orderDetail[]
}

model categories {
  id             String    @id @default(cuid())
  storeId        String
  name           String
  description    String?
  profilePicture String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  barcodePrefix  String?
  isActive       Boolean   @default(true)
  Image          Image[]
  store          store     @relation(fields: [storeId], references: [id])
  products       product[]

  @@unique([storeId, barcodePrefix])
}

model product {
  id             String         @id @default(cuid())
  storeId        String
  name           String
  description    String?
  price          Float
  stock          Int            @default(0)
  profilePicture String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  barcode        String?
  categoryId     String?
  Image          Image[]
  stockHistories StockHistory[]
  orderDetails   orderDetail[]
  category       categories?    @relation(fields: [categoryId], references: [id])
  store          store          @relation(fields: [storeId], references: [id])

  @@unique([storeId, barcode])
}

model orderDetail {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int      @default(1)
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     order    @relation(fields: [orderId], references: [id])
  product   product  @relation(fields: [productId], references: [id])
}

model payment {
  id            String   @id @default(cuid())
  storeId       String
  userId        String?
  clientId      String?
  amount        Float
  sucursalId    String?
  paymentDate   DateTime @default(now())
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        client?  @relation(fields: [clientId], references: [id])
  store         store    @relation(fields: [storeId], references: [id])
  user          user?    @relation(fields: [userId], references: [id])
}

model setting {
  id          String   @id @default(cuid())
  storeId     String?
  name        String
  detail      String?
  type        String
  value       String?
  code        String?
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Image {
  id           String      @id @default(cuid())
  url          String
  cloudinaryId String?
  altText      String?
  isMain       Boolean     @default(false)
  order        Int?
  clientId     String?
  userId       String?
  supplierId   String?
  categoryId   String?
  productId    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  category     categories? @relation(fields: [categoryId], references: [id])
  client       client?     @relation(fields: [clientId], references: [id])
  product      product?    @relation(fields: [productId], references: [id])
  supplier     supplier?   @relation(fields: [supplierId], references: [id])
  user         user?       @relation(fields: [userId], references: [id])
}

model CashRegister {
  id             String             @id @default(cuid())
  storeId        String
  openedByUserId String
  closedByUserId String?
  openingAmount  Float
  closingAmount  Float?
  expectedAmount Float?
  difference     Float?
  observation    String?
  status         CashRegisterStatus @default(OPEN)
  openedAt       DateTime           @default(now())
  closedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  cashMovements  CashMovement[]
  closedByUser   user?              @relation("ClosedCashRegisters", fields: [closedByUserId], references: [id])
  openedByUser   user               @relation("OpenedCashRegisters", fields: [openedByUserId], references: [id])
  store          store              @relation(fields: [storeId], references: [id])
  orders         order[]
}

model CashMovement {
  id             String       @id @default(cuid())
  storeId        String
  cashRegisterId String
  userId         String
  type           MovementType
  amount         Float
  description    String?
  reference      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  store          store        @relation(fields: [storeId], references: [id])
  user           user         @relation(fields: [userId], references: [id])
}

model StockHistory {
  id             String            @id @default(cuid())
  storeId        String
  productId      String
  userId         String?
  type           StockMovementType
  previousStock  Int
  movementAmount Int
  currentStock   Int
  description    String?
  createdAt      DateTime          @default(now())
  product        product           @relation(fields: [productId], references: [id])
  store          store             @relation(fields: [storeId], references: [id])
  user           user?             @relation(fields: [userId], references: [id])
}

model OrderPayment {
  id            String   @id @default(cuid())
  orderId       String
  paymentMethod String
  amount        Float
  createdAt     DateTime @default(now())
  order         order    @relation(fields: [orderId], references: [id])
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum MovementType {
  INCOME
  EXPENSE
}

enum StockMovementType {
  SALE
  MANUAL_ADJUSTMENT
  PURCHASE
  RETURN
  INITIAL
}

enum Role {
  SUPERADMIN
  ADMIN
  USUARIO
}
